# ---- Runtime ----
NODE_ENV=development
# Global dry-run: disables ALL external side effects (email sending, etc.)
DRY_RUN=true
LOG_LEVEL=info
# Raw API capture for debugging (values: off | debug) — dev only, redacted, gitignored
RAW_CAPTURE=off

# ---- Live API safety guardrails ----
# Live requests to the college server are OPT-IN. When false, the app refuses
# to contact tpoapi.vierp.in (offline/mock development only). Never enable
# casually: every live request is recorded in var/api-audit.log.
ALLOW_LIVE_API=false
# Hard caps protecting the college server from excessive traffic.
MAX_API_CALLS_PER_RUN=60
API_MIN_REQUEST_INTERVAL_MS=1000

# ---- TPO API session ----
# First-party login (recommended): the client generates its own device key,
# solves the ALTCHA challenge and logs in exactly like the browser does.
# Used by `npm run login`.
TPO_USERNAME=
TPO_PASSWORD=

# Legacy manual paste (diagnostics only — the API rejects replayed tuples).
TPO_API_BASE_URL=https://tpoapi.vierp.in
TPO_EPS_UID=
TPO_EPS_TENANT=
TPO_DEVICE_SIGNATURE=
# Milliseconds epoch of the captured request — pasted as-is on replay
TPO_REQUEST_TIMESTAMP=

# ---- Database (Prisma / PostgreSQL) ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/placement_intel?schema=public

# ---- Sync ----
SYNC_INTERVAL_MINUTES=30

# ---- Email notifications (M10) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_TO=

# ---- AI structured extraction (M9) ----
# Any OpenAI-compatible provider works (OpenAI, OpenRouter, Groq, ...).
# Leaving AI_API_KEY empty disables the AI layer entirely — the pipeline
# stays deterministic-only.
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
